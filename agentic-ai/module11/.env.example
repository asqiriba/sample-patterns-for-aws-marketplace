# Module 11 environment: names only. Copy to the git-ignored module11/.local/env.sh, fill in the values and
# `source module11/.local/env.sh` from agentic-ai/ before any live command (the offline tests need none of it).
# Every line is exported, because `python -m module11` reads them from its environment. Secrets are never values
# here: the two partner tokens are Secrets Manager names, read by ARN at run time.

# AWS profile and Region of the account that runs Module 10's cloud mode (us-east-1 in the build).
export AWS_PROFILE=
export AWS_REGION=
export AWS_DEFAULT_REGION=
# Caller-identity check: every live command refuses a different account (<your-account-id>, 12 digits).
export M11_EXPECTED_ACCOUNT=

# The Python venv from module11/README.md (absolute path), used by the presenter's `d N` function and linked as
# each Pulumi program's venv.
export VENV=

# Pulumi DIY backend (S3) and secrets provider (KMS) that infrastructure/bootstrap/state_backend.py creates:
#   s3://m11-pulumi-state-<your-account-id>-<region>  and  awskms://alias/m11-pulumi-secrets?region=<region>
# MR preview stacks use s3://m11-pulumi-state-preview-<your-account-id>-<region>.
export PULUMI_BACKEND_URL=
export M11_SECRETS_PROVIDER=
export M11_PREVIEW_STATE_BACKEND=
export PULUMI_SKIP_UPDATE_CHECK=1

# GitLab harness project: its path (<your-group>/devops-companion-harness), its numeric ID, and the Secrets Manager
# name of its project access token (devops-companion/partners/gitlab-token). The CODEOWNERS group defaults to the
# project's group; set M11_GITLAB_GROUP only if harness-owners, platform and quality live in another group.
export M11_GITLAB_PROJECT=
export M11_GITLAB_PROJECT_ID=
export M11_GITLAB_TOKEN_SECRET=
# export M11_GITLAB_GROUP=
# Who may approve, as GitLab usernames (JSON). `partners up` writes the approval rules from it, and the bot merges
# its own MRs (demo prep, baseline refresh --merge) only when these people's approvals are there. The quality
# reviewer must be a different person from every harness-owner and platform member.
export M11_APPROVER_USERS='{"harness-owners": ["<user>"], "platform": ["<user>"], "quality": ["<another-user>"]}'
# The [Quality] code-owner section's users (comma-separated), rendered into .gitlab/CODEOWNERS by seed.py.
export M11_QUALITY_USERS=

# Vercel team ID and slug, and the Secrets Manager name of the team-scoped token (devops-companion/partners/vercel-token).
export M11_VERCEL_TEAM_ID=
export M11_VERCEL_TOKEN_SECRET=
# The team slug predicts an MR preview's alias when an MR has no UI wiring; without it such an MR stack gets an
# unroutable .invalid origin.
# export M11_VERCEL_TEAM_SLUG=
# Prod's UI origin: your Vercel project's production domain (for example https://<your-project>.vercel.app).
# Read when the prod stack is first configured; unset, prod gets an unroutable .invalid origin.
# export M11_UI_ORIGIN_PROD=

# Module 10's Pulumi stack (by reference) and its terminal client's credentials file (Cognito users).
export M11_MODULE10_STACK=
export M11_MODULE10_CREDENTIALS_FILE=

# The release pipeline's source provider: gitlab (CodeConnections).
export M11_SOURCE_PROVIDER=gitlab

# Comma-separated IAM principal ARNs allowed to assume the stage deployers and to run demo arm / demo rearm
# (for example arn:aws:iam::<your-account-id>:user/<you>).
export M11_OPERATOR_PRINCIPALS=

# Optional: extra user names that `module11 captures export` redacts (comma-separated).
# export M11_REDACT_NAMES=
